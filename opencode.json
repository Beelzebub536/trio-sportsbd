{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "npm install*": "ask",
      "npm i *": "ask",
      "npx shadcn*": "allow",
      "rm *": "ask",
      "del *": "ask",
      "Remove-Item*": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "*migrate reset*": "deny",
      "*--force-reset*": "deny",
      "*--accept-data-loss*": "deny"
    }
  }
}
